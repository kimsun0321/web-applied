<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>キーの情報を表示する</title>

  <style>
    body {
      font-family: sans-serif;
      padding: 30px;
    }

    h1 {
      color: #315b83;
    }

    li {
      font-size: 20px;
      margin: 15px 0;
    }

    span {
      font-weight: bold;
      color: blue;
    }
  </style>
</head>

<body>
  <h1>キーの情報を表示する</h1>

  <p>なにかキーを押すと、下に表示されます。</p>

  <ul>
    <li>e.key：<span id="ekey">-</span></li>
    <li>e.code：<span id="ecode">-</span></li>
    <li>e.type：<span id="etype">-</span></li>
  </ul>

  <script>
    const ekey = document.getElementById("ekey");
    const ecode = document.getElementById("ecode");
    const etype = document.getElementById("etype");

    // キーを押したとき（keydown）
    document.addEventListener("keydown", (e) => {
      ekey.innerText = e.key;
      ecode.innerText = e.code;
      etype.innerText = e.type;
    });

    // キーを離したとき（keyup）
    document.addEventListener("keyup", (e) => {
      etype.innerText = e.type;
    });
  </script>
</body>
</html>